{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@org/error-catalog": ["libs/shared/error-catalog/src/index.ts"],
      "@api/app/*": ["apps/nest-api/src/app/*"],
      "@api/users/*": ["apps/nest-api/src/app/features/users/*"],
      "@api/auth/*": ["apps/nest-api/src/app/features/auth/*"],
      "@api/common/*": ["apps/nest-api/src/app/common/*"],
      "@story/ui": ["libs/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
