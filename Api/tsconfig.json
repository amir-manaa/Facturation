{
  "ts-node": {
        // Do not forget to `npm i -D tsconfig-paths`
        "require": ["tsconfig-paths/register"]
    },
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
        "@controllers/*": ["src/controllers/*"],
        "@middleware/*": ["src/middleware/*"],
        "@models/*": ["src/models/*"],
        "@route/*": ["src/routes/*"],
        "@routes": ["src/routes/index"],
        "@utils/*": ["src/utils/*"],
        "@interfaces/*": ["src/shared/interfaces/index"],
        "@enums/*": ["src/shared/enums/*"],
        "@constants/*": ["src/constants/*"],
        "*": ["node_modules/*"]
    },
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es2021",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist"
  },
  "lib": ["es2021"]
  }